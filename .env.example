# 이 파일을 .env 로 복사한 뒤 키를 넣으세요. .env 는 제출하지 않습니다.

# [필수] 회의 정리에 쓰는 Claude API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# [선택] 녹음 파일 → 텍스트 변환 (Claude에는 음성 인식이 없음)
# 1순위: CLOVA Speech (네이버클라우드, 한국어·화자 구분). 콘솔 > CLOVA Speech > 도메인 > 빌더 > 설정 > 연동 정보
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# 2순위: whisperX (이 컴퓨터에서 무료 실행 · .venv-whisperx 가 있으면 자동으로 켜짐, 끄려면 WHISPERX=0)
# 화자 구분용 허깅페이스 토큰: huggingface.co/settings/tokens (pyannote/speaker-diarization-3.1 사용 동의 필요)
HF_TOKEN=
# WHISPERX_MODEL=large-v3-turbo
# 3순위: OpenAI Whisper (화자 구분 없음)
# 비워 두면 녹음 업로드는 꺼지고 전사본 붙여넣기만 됩니다.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# [선택] 노션 연동 — 토큰이 비어 있으면 노션 기능은 꺼지고 로컬 파일만 씁니다.
# 토큰: notion.so/profile/integrations 에서 내부 통합을 만들고 '내부 통합 시크릿'을 복사
NOTION_TOKEN=
# 아래 ID는 노션에서 해당 DB·페이지 링크의 32자리 ID (README의 '노션 연동' 참고)
NOTION_MEETING_DS_ID=
NOTION_TASK_DS_ID=
NOTION_POLICY_PAGE_ID=

PORT=3000
# 팀·구성원 DB (팀 목록과 구성원 명단)
NOTION_TEAM_DS_ID=
# 사이트 UI 문구 용어집 (문구 검수 기준)
NOTION_UI_PAGE_ID=
NOTION_UI_STRINGS_DS_ID=
